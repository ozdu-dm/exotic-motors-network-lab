[Unit]
Description=Gunicorn — Exotic Motors Web App
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/exoticsweb
Environment=PATH=/var/www/exoticsweb/env/bin
ExecStart=/var/www/exoticsweb/env/bin/gunicorn -w 4 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
